{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wonkixer",
  "identifier": "com.chrismacdonaldw.wonkixer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "wonkixer",
        "width": 980,
        "height": 720,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0b0c0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "chrismacdonaldw",
    "copyright": "Copyright (c) 2026 chrismacdonaldw",
    "homepage": "https://github.com/chrismacdonaldw/wonkixer",
    "shortDescription": "Live microphone processing for Windows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzNEE3RUQ5RTdCRjVGN0UKUldSK1g3L24yWDVLRXliVU5FOVhxeUovR0hGOXZQbWN6Nk8zSnlqejl1bnpLWk5Pd3h6bnVWSjYK",
      "endpoints": [
        "https://github.com/chrismacdonaldw/wonkixer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
