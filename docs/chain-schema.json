{
  "stages": [
    {
      "id": "input",
      "key": "input",
      "label": "INPUT",
      "title": "Input",
      "family": "level",
      "bypassable": false,
      "optional": false,
      "latencyMs": 0.0,
      "blurb": "Trims the mic before anything else. Aim for peaks around -12 dBFS while you talk normally."
    },
    {
      "id": "hpf",
      "key": "hpf",
      "label": "HIGH-PASS",
      "title": "High-pass",
      "family": "filter",
      "bypassable": true,
      "optional": false,
      "latencyMs": 0.0,
      "blurb": "Cuts rumble, breath pops and desk thumps below your voice. Raise it until your voice starts to thin, then back off a little."
    },
    {
      "id": "rnnoise",
      "key": "rnnoise",
      "label": "NOISE SUPPRESSION",
      "title": "Noise suppression",
      "family": "cleanup",
      "bypassable": true,
      "optional": true,
      "latencyMs": 10.0,
      "blurb": "Removes steady background noise such as fans and hum, even while you talk. It works on 10 ms frames, so it adds about 10 ms of latency."
    },
    {
      "id": "expander",
      "key": "expander",
      "label": "EXPANDER",
      "title": "Expander",
      "family": "dynamics",
      "bypassable": true,
      "optional": false,
      "latencyMs": 0.0,
      "blurb": "Turns room noise down in the gaps between phrases. Gentler than a gate, and it never fully mutes."
    },
    {
      "id": "deesser",
      "key": "deesser",
      "label": "DE-ESSER",
      "title": "De-esser",
      "family": "sibilance",
      "bypassable": true,
      "optional": false,
      "latencyMs": 0.0,
      "blurb": "Tames harsh s and sh sounds. Split band ducks only the highs, so the body of your voice is untouched."
    },
    {
      "id": "eq",
      "key": "eq",
      "label": "EQ",
      "title": "EQ",
      "family": "eq",
      "bypassable": true,
      "optional": false,
      "latencyMs": 0.0,
      "blurb": "Shapes tone. A small cut near 250 Hz clears headset mud; a lift near 4 kHz adds clarity. Drag a numbered point, or type exact values below."
    },
    {
      "id": "compressor",
      "key": "compressor",
      "label": "COMPRESSOR",
      "title": "Compressor",
      "family": "dynamics",
      "bypassable": true,
      "optional": false,
      "latencyMs": 0.0,
      "blurb": "Evens out loud and quiet words so people hear you at a steady level. Makeup brings the level back up afterwards."
    },
    {
      "id": "limiter",
      "key": "limiter",
      "label": "LIMITER",
      "title": "Limiter",
      "family": "dynamics",
      "bypassable": true,
      "optional": false,
      "latencyMs": 5.0,
      "blurb": "A brickwall at the ceiling with 5 ms lookahead. Catches shouts and laughs before they clip."
    },
    {
      "id": "output",
      "key": "output",
      "label": "OUTPUT",
      "title": "Output",
      "family": "level",
      "bypassable": false,
      "optional": false,
      "latencyMs": 0.0,
      "blurb": "Final trim into the virtual cable. A hard clip at 0 dBFS follows as a safety net."
    }
  ],
